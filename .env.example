# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub ni pegues estas claves en un chat.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública ("publishable" o "anon"). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta ("secret" o "service_role"). SOLO servidor. Salta RLS: trátala como una contraseña maestra.
SUPABASE_SECRET_KEY=

# URL pública de la app (para enlaces en correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para el script de usuarios de ejemplo: tu correo real para el Superadmin
SUPERADMIN_EMAIL=

# Amazon SES → SNS: ARN del tema que recibe entregas, rebotes y quejas (ver docs/CONFIGURACION.md)
SES_SNS_TOPIC_ARN=
